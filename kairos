#!/usr/bin/env bash

if [ -z "${BASH_VERSION:-}" ] || shopt -oq posix; then
    exec /bin/bash "$0" "$@"
fi

set -u

ENTRYPOINT="${BASH_SOURCE[0]}"
if [ -L "$ENTRYPOINT" ]; then
    LINK_TARGET=$(readlink "$ENTRYPOINT")
    if [[ "$LINK_TARGET" = /* ]]; then
        ENTRYPOINT="$LINK_TARGET"
    else
        ENTRYPOINT="$(cd "$(dirname "$ENTRYPOINT")" && pwd)/$LINK_TARGET"
    fi
fi

SCRIPT_DIR=$(cd "$(dirname "$ENTRYPOINT")" && pwd)
GUM_BIN="${KAIROS_GUM_BIN:-gum}"
ORGANIZE_SCRIPT="${KAIROS_ORGANIZE_SCRIPT:-$SCRIPT_DIR/organize_raw_by_date.sh}"
RENAME_SCRIPT="${KAIROS_RENAME_SCRIPT:-$SCRIPT_DIR/rename_raw.sh}"
AFTERRAW_SCRIPT="${KAIROS_AFTERRAW_SCRIPT:-$SCRIPT_DIR/afterraw.sh}"
MULTI_SELECT_SCRIPT="${KAIROS_MULTI_SELECT_SCRIPT:-$SCRIPT_DIR/multi_select.sh}"
PHOTO_ROOT="${KAIROS_PHOTO_ROOT:-/Users/robbie/Dropbox/__攝影}"
LAST_STATUS=0
SELECTED_TARGET=""
SELECTED_RAWS=()
RAW_ALL_OPTION="全部 RAW 檔案"

trap 'exit 130' INT

style() {
    "$GUM_BIN" style "$@"
}

header() {
    style \
        --border rounded \
        --border-foreground 212 \
        --foreground 255 \
        --padding "1 4" \
        --margin "1 0" \
        --align center \
        "KAIROS  •  IMAGE WORKFLOW"
}

clear_screen() {
    if [ -t 1 ]; then
        clear
    fi
}

pause_for_dashboard() {
    printf '\n按 Enter 返回儀表板'
    IFS= read -r _ || true
}

run_worker() {
    local pause_mode="dashboard"
    local title
    local status

    if [ "${1:-}" = "--return-menu" ]; then
        pause_mode="menu"
        shift
    fi

    title="$1"
    shift

    clear_screen
    header
    style --foreground 212 --bold "$title"
    printf '\n'

    "$@"
    status=$?
    LAST_STATUS=$status

    printf '\n'
    if [ "$status" -eq 0 ]; then
        style --foreground 42 --bold "✓ 程序完成"
    else
        style --foreground 196 --bold "✗ 程序失敗（exit ${status}）"
    fi
    if [ "$pause_mode" = "dashboard" ]; then
        pause_for_dashboard
    fi
}

photo_projects() {
    local project

    # 整個攝影目錄只搜尋一次，再依專案取照片的最新修改時間；
    # 以 D 開頭的列是專案目錄本身，讓沒有照片的專案也會列出（排在最後）
    {
        for project in "$PHOTO_ROOT"/*; do
            [ -d "$project" ] && printf 'D %s/\n' "$project"
        done
        find "$PHOTO_ROOT" -mindepth 2 -type f \( \
            -iname '*.arw' -o -iname '*.raw' -o -iname '*.dng' -o \
            -iname '*.cr2' -o -iname '*.cr3' -o -iname '*.nef' -o \
            -iname '*.orf' -o -iname '*.raf' -o -iname '*.rw2' -o \
            -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.tif' -o \
            -iname '*.tiff' -o -iname '*.png' -o -iname '*.heic' \
            \) -exec stat -f '%m %N' {} +
    } | KAIROS_PHOTO_ROOT_PREFIX="$PHOTO_ROOT/" awk '
        BEGIN {
            root = ENVIRON["KAIROS_PHOTO_ROOT_PREFIX"]
            root_length = length(root)
        }
        {
            space = index($0, " ")
            mtime = substr($0, 1, space - 1)
            path = substr($0, space + 1)
            if (substr(path, 1, root_length) != root) {
                next
            }
            rest = substr(path, root_length + 1)
            project = substr(rest, 1, index(rest, "/") - 1)
            if (project == "") {
                next
            }
            if (mtime == "D") {
                listed[project] = 1
                if (!(project in latest)) {
                    latest[project] = 0
                }
            } else if (!(project in latest) || mtime + 0 > latest[project]) {
                latest[project] = mtime + 0
            }
        }
        END {
            for (project in listed) {
                printf "%.0f\t%s\n", latest[project], project
            }
        }
    ' | LC_ALL=C sort -t $'\t' -k1,1nr -k2 | cut -f2-
}

choose_photo_target() {
    local project
    local -a projects=()

    SELECTED_TARGET=""
    clear_screen
    header
    style --foreground 245 "依照片修改時間由新到舊排列"
    while IFS= read -r project; do
        projects+=("$project")
    done < <(photo_projects)
    if [ "${#projects[@]}" -eq 0 ]; then
        style --foreground 196 "找不到攝影專案：$PHOTO_ROOT"
        pause_for_dashboard
        return 1
    fi

    SELECTED_TARGET=$("$GUM_BIN" choose --header "選擇修圖專案（ESC 返回主選單）" --height 15 \
        -- "${projects[@]}") || return 1
    [ -n "$SELECTED_TARGET" ]
}

project_raw_files() {
    local raw_dir="$PHOTO_ROOT/$1/RAW"
    local file
    local name

    [ -d "$raw_dir" ] || return 0
    for file in "$raw_dir"/*; do
        [ -f "$file" ] || continue
        name="${file##*/}"
        case "$name" in
            *.[Aa][Rr][Ww]|*.[Rr][Aa][Ww]) printf '%s\n' "$name" ;;
        esac
    done | LC_ALL=C sort
}

# 選擇要處理的 RAW 檔（可多選）：SELECTED_RAWS 為空代表全部；按 ESC 回傳 1，代表返回操作選單
choose_raw_files() {
    local target="$1"
    local operation="$2"
    local name
    local choice
    local -a raw_files=()

    SELECTED_RAWS=()
    while IFS= read -r name; do
        raw_files+=("$name")
    done < <(project_raw_files "$target")
    # 沒有 RAW 檔時直接以全部模式執行，由 worker 回報找不到檔案
    [ "${#raw_files[@]}" -gt 0 ] || return 0

    clear_screen
    header
    # gum choose 多選時，沒有勾選就按 Enter 不會選定游標項目，因此改用自訂的多選清單
    choice=$(/bin/bash "$MULTI_SELECT_SCRIPT" "專案：${target}｜${operation}｜選擇 RAW 檔案" \
        "$RAW_ALL_OPTION" "${raw_files[@]}") || return 1

    while IFS= read -r name; do
        [ -n "$name" ] || continue
        if [ "$name" = "$RAW_ALL_OPTION" ]; then
            SELECTED_RAWS=()
            return 0
        fi
        SELECTED_RAWS+=("$name")
    done <<< "$choice"
    [ "${#SELECTED_RAWS[@]}" -gt 0 ]
}

selected_raws_label() {
    if [ "${#SELECTED_RAWS[@]}" -eq 1 ]; then
        printf '%s' "${SELECTED_RAWS[0]}"
    else
        printf '%s 個 RAW 檔案' "${#SELECTED_RAWS[@]}"
    fi
}

confirm_redo() {
    local target="$1"
    local message
    local names=""
    local name

    if [ "${#SELECTED_RAWS[@]}" -gt 0 ]; then
        for name in "${SELECTED_RAWS[@]}"; do
            names="${names:+${names}、}${name}"
        done
        message="重新修圖會刪除「${target}」中 ${names} 的 .xmp、.acr 檔案及對應的 PSD、IG、FB 成品，確定要繼續嗎？"
    else
        message="重新修圖會刪除「${target}」RAW 目錄下的 .xmp、.acr 檔案及 PSD、IG、FB 目錄，確定要繼續嗎？"
    fi

    "$GUM_BIN" confirm --default=false --affirmative "確定" --negative "取消" "$message"
}

afterraw_menu() {
    local choice
    local target
    local title
    local raw_name
    local -a args

    while true; do
        choose_photo_target || return 0
        target="$SELECTED_TARGET"
        while true; do
            clear_screen
            header
            choice=$("$GUM_BIN" choose --header "專案：${target}（ESC 返回專案清單）" --height 7 -- \
                "1  重新修圖" \
                "2  前置作業" \
                "3  載入 RAW" \
                "4  開啟 PSD 檔案" \
                "5  IG＋FB 後置輸出" \
                "6  僅 IG 後置輸出" \
                "7  僅 FB 後置輸出") || break

            case "$choice" in
                "1  重新修圖") title="AfterRAW｜重新修圖"; args=(--redo) ;;
                "2  前置作業") title="AfterRAW｜前置作業"; args=(--pre) ;;
                "3  載入 RAW") title="AfterRAW｜載入 RAW"; args=(--load-raw) ;;
                "4  開啟 PSD 檔案") title="AfterRAW｜開啟 PSD 檔案"; args=(--open-psd) ;;
                "5  IG＋FB 後置輸出") title="AfterRAW｜IG＋FB 後置輸出"; args=() ;;
                "6  僅 IG 後置輸出") title="AfterRAW｜僅 IG 後置輸出"; args=(--ig) ;;
                "7  僅 FB 後置輸出") title="AfterRAW｜僅 FB 後置輸出"; args=(--fb) ;;
                *) continue ;;
            esac

            choose_raw_files "$target" "${choice#*  }" || continue
            if [ "${args[0]:-}" = "--redo" ]; then
                confirm_redo "$target" || continue
            fi
            if [ "${#SELECTED_RAWS[@]}" -gt 0 ]; then
                for raw_name in "${SELECTED_RAWS[@]}"; do
                    args+=(--file "$raw_name")
                done
                title="${title}｜$(selected_raws_label)"
            fi
            args+=("$target")

            run_worker --return-menu "$title" /bin/bash "$AFTERRAW_SCRIPT" "${args[@]}"
        done
    done
}

main() {
    local choice

    if [ "$#" -ne 0 ]; then
        printf 'kairos 不接受參數；請直接輸入 kairos 開啟儀表板。\n' >&2
        return 64
    fi

    if ! command -v "$GUM_BIN" > /dev/null 2>&1; then
        printf '找不到 gum，請先執行：brew install gum\n' >&2
        return 127
    fi

    while true; do
        clear_screen
        header
        choice=$("$GUM_BIN" choose --header "選擇要進行的程序（ESC 離開）" --height 3 -- \
            "1  傳輸記憶卡 RAW 檔案" \
            "2  轉移 RAW 檔案" \
            "3  修圖") || return "$LAST_STATUS"

        case "$choice" in
            "1  傳輸記憶卡 RAW 檔案")
                run_worker "傳輸記憶卡 RAW 檔案" /bin/bash "$ORGANIZE_SCRIPT"
                ;;
            "2  轉移 RAW 檔案")
                run_worker "轉移 RAW 檔案" /bin/bash "$RENAME_SCRIPT"
                ;;
            "3  修圖")
                afterraw_menu
                ;;
        esac
    done
}

main "$@"
