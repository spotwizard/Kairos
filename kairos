#!/usr/bin/env bash

if [ -z "${BASH_VERSION:-}" ] || shopt -oq posix; then
    exec /bin/bash "$0" "$@"
fi

set -u

ENTRYPOINT="${BASH_SOURCE[0]}"
if [ -L "$ENTRYPOINT" ]; then
    LINK_TARGET=$(readlink "$ENTRYPOINT")
    if [[ "$LINK_TARGET" = /* ]]; then
        ENTRYPOINT="$LINK_TARGET"
    else
        ENTRYPOINT="$(cd "$(dirname "$ENTRYPOINT")" && pwd)/$LINK_TARGET"
    fi
fi

SCRIPT_DIR=$(cd "$(dirname "$ENTRYPOINT")" && pwd)
GUM_BIN="${KAIROS_GUM_BIN:-gum}"
ORGANIZE_SCRIPT="${KAIROS_ORGANIZE_SCRIPT:-$SCRIPT_DIR/organize_raw_by_date.sh}"
RENAME_SCRIPT="${KAIROS_RENAME_SCRIPT:-$SCRIPT_DIR/rename_raw.sh}"
AFTERRAW_SCRIPT="${KAIROS_AFTERRAW_SCRIPT:-$SCRIPT_DIR/afterraw.sh}"
PHOTO_ROOT="${KAIROS_PHOTO_ROOT:-/Users/robbie/Dropbox/__攝影}"
LAST_STATUS=0
SELECTED_TARGET=""
SELECTED_RAW=""
RAW_ALL_OPTION="全部 RAW 檔案"

trap 'exit 130' INT

style() {
    "$GUM_BIN" style "$@"
}

header() {
    style \
        --border rounded \
        --border-foreground 212 \
        --foreground 255 \
        --padding "1 4" \
        --margin "1 0" \
        --align center \
        "KAIROS  •  IMAGE WORKFLOW"
}

clear_screen() {
    if [ -t 1 ]; then
        clear
    fi
}

pause_for_dashboard() {
    printf '\n按 Enter 返回儀表板'
    IFS= read -r _ || true
}

run_worker() {
    local pause_mode="dashboard"
    local title
    local status

    if [ "${1:-}" = "--return-menu" ]; then
        pause_mode="menu"
        shift
    fi

    title="$1"
    shift

    clear_screen
    header
    style --foreground 212 --bold "$title"
    printf '\n'

    "$@"
    status=$?
    LAST_STATUS=$status

    printf '\n'
    if [ "$status" -eq 0 ]; then
        style --foreground 42 --bold "✓ 程序完成"
    else
        style --foreground 196 --bold "✗ 程序失敗（exit ${status}）"
    fi
    if [ "$pause_mode" = "dashboard" ]; then
        pause_for_dashboard
    fi
}

photo_projects() {
    local project
    local modified

    for project in "$PHOTO_ROOT"/*; do
        [ -d "$project" ] || continue
        modified=$(find "$project" -type f \( \
            -iname '*.arw' -o -iname '*.raw' -o -iname '*.dng' -o \
            -iname '*.cr2' -o -iname '*.cr3' -o -iname '*.nef' -o \
            -iname '*.orf' -o -iname '*.raf' -o -iname '*.rw2' -o \
            -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.tif' -o \
            -iname '*.tiff' -o -iname '*.png' -o -iname '*.heic' \
            \) -exec stat -f '%m' {} + \
            | awk '$1 > latest { latest = $1 } END { printf "%.0f", latest }')
        printf '%s\t%s\n' "$modified" "${project##*/}"
    done | LC_ALL=C sort -t $'\t' -k1,1nr -k2 | cut -f2-
}

choose_photo_target() {
    local project
    local -a projects=()

    SELECTED_TARGET=""
    clear_screen
    header
    style --foreground 245 "依照片修改時間由新到舊排列"
    while IFS= read -r project; do
        projects+=("$project")
    done < <(photo_projects)
    if [ "${#projects[@]}" -eq 0 ]; then
        style --foreground 196 "找不到攝影專案：$PHOTO_ROOT"
        pause_for_dashboard
        return 1
    fi

    SELECTED_TARGET=$("$GUM_BIN" choose --header "選擇修圖專案（ESC 返回主選單）" --height 15 \
        -- "${projects[@]}") || return 1
    [ -n "$SELECTED_TARGET" ]
}

project_raw_files() {
    local raw_dir="$PHOTO_ROOT/$1/RAW"
    local file
    local name

    [ -d "$raw_dir" ] || return 0
    for file in "$raw_dir"/*; do
        [ -f "$file" ] || continue
        name="${file##*/}"
        case "$name" in
            *.[Aa][Rr][Ww]|*.[Rr][Aa][Ww]) printf '%s\n' "$name" ;;
        esac
    done | LC_ALL=C sort
}

# 選擇要處理的 RAW 檔：SELECTED_RAW 為空字串代表全部；按 ESC 回傳 1，代表返回操作選單
choose_raw_file() {
    local target="$1"
    local operation="$2"
    local name
    local choice
    local -a raw_files=()

    SELECTED_RAW=""
    while IFS= read -r name; do
        raw_files+=("$name")
    done < <(project_raw_files "$target")
    # 沒有 RAW 檔時直接以全部模式執行，由 worker 回報找不到檔案
    [ "${#raw_files[@]}" -gt 0 ] || return 0

    clear_screen
    header
    choice=$("$GUM_BIN" choose --header "專案：${target}｜${operation}｜選擇 RAW 檔案（ESC 返回操作選單）" --height 15 \
        -- "$RAW_ALL_OPTION" "${raw_files[@]}") || return 1

    case "$choice" in
        "$RAW_ALL_OPTION") SELECTED_RAW="" ;;
        "") return 1 ;;
        *) SELECTED_RAW="$choice" ;;
    esac
}

confirm_redo() {
    local target="$1"
    local raw_file="$2"
    local message

    if [ -n "$raw_file" ]; then
        message="重新修圖會刪除「${target}」中 ${raw_file} 的 .xmp、.acr 檔案及對應的 PSD、IG、FB 成品，確定要繼續嗎？"
    else
        message="重新修圖會刪除「${target}」RAW 目錄下的 .xmp、.acr 檔案及 PSD、IG、FB 目錄，確定要繼續嗎？"
    fi

    "$GUM_BIN" confirm --default=false --affirmative "確定" --negative "取消" "$message"
}

afterraw_menu() {
    local choice
    local target
    local title
    local -a args

    while true; do
        choose_photo_target || return 0
        target="$SELECTED_TARGET"
        while true; do
            clear_screen
            header
            choice=$("$GUM_BIN" choose --header "專案：${target}（ESC 返回專案清單）" --height 8 -- \
                "1  重新修圖" \
                "2  前置作業" \
                "3  載入 RAW" \
                "4  開啟 PSD 檔案" \
                "5  IG＋FB 後置輸出" \
                "6  僅 IG 後置輸出" \
                "7  僅 FB 後置輸出" \
                "0  重新選擇專案") || break

            case "$choice" in
                "1  重新修圖") title="AfterRAW｜重新修圖"; args=(--redo) ;;
                "2  前置作業") title="AfterRAW｜前置作業"; args=(--pre) ;;
                "3  載入 RAW") title="AfterRAW｜載入 RAW"; args=(--load-raw) ;;
                "4  開啟 PSD 檔案") title="AfterRAW｜開啟 PSD 檔案"; args=(--open-psd) ;;
                "5  IG＋FB 後置輸出") title="AfterRAW｜IG＋FB 後置輸出"; args=() ;;
                "6  僅 IG 後置輸出") title="AfterRAW｜僅 IG 後置輸出"; args=(--ig) ;;
                "7  僅 FB 後置輸出") title="AfterRAW｜僅 FB 後置輸出"; args=(--fb) ;;
                "0  重新選擇專案") break ;;
                *) continue ;;
            esac

            choose_raw_file "$target" "${choice#*  }" || continue
            if [ "${args[0]:-}" = "--redo" ]; then
                confirm_redo "$target" "$SELECTED_RAW" || continue
            fi
            if [ -n "$SELECTED_RAW" ]; then
                args+=(--file "$SELECTED_RAW")
                title="${title}｜${SELECTED_RAW}"
            fi
            args+=("$target")

            run_worker --return-menu "$title" /bin/bash "$AFTERRAW_SCRIPT" "${args[@]}"
        done
    done
}

main() {
    local choice

    if [ "$#" -ne 0 ]; then
        printf 'kairos 不接受參數；請直接輸入 kairos 開啟儀表板。\n' >&2
        return 64
    fi

    if ! command -v "$GUM_BIN" > /dev/null 2>&1; then
        printf '找不到 gum，請先執行：brew install gum\n' >&2
        return 127
    fi

    while true; do
        clear_screen
        header
        choice=$("$GUM_BIN" choose --header "選擇要進行的程序" --height 4 -- \
            "1  傳輸記憶卡 RAW 檔案" \
            "2  轉移 RAW 檔案" \
            "3  修圖" \
            "0  離開") || return "$LAST_STATUS"

        case "$choice" in
            "1  傳輸記憶卡 RAW 檔案")
                run_worker "傳輸記憶卡 RAW 檔案" /bin/bash "$ORGANIZE_SCRIPT"
                ;;
            "2  轉移 RAW 檔案")
                run_worker "轉移 RAW 檔案" /bin/bash "$RENAME_SCRIPT"
                ;;
            "3  修圖")
                afterraw_menu
                ;;
            "0  離開")
                return "$LAST_STATUS"
                ;;
        esac
    done
}

main "$@"
